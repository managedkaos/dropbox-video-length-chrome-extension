{
    "manifest_version": 3,
    "name": "Gemini: Dropbox Video Duration",
    "version": "1.0",
    "permissions": [
        "storage"
    ],
    "host_permissions": [
        "https://www.dropbox.com/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://www.dropbox.com/scl/fo/*"
            ],
            "js": [
                "content.js"
            ]
        }
    ]
}

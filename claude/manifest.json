{
    "manifest_version": 3,
    "name": "Claude: Dropbox Video Duration",
    "version": "1.0",
    "description": "Shows video durations for Dropbox video files",
    "permissions": [
        "activeTab",
        "scripting"
    ],
    "host_permissions": [
        "https://www.dropbox.com/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://www.dropbox.com/scl/fo/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    }
}
